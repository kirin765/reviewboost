# Optional (추천): OpenAI를 쓰면 개선 제안 품질이 올라갑니다.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# (선택) LLM 분류 타임아웃(ms), 기본 8000
# OPENAI_CLASSIFY_TIMEOUT_MS=8000
# (선택) LLM 분류 배치 크기, 기본 60
# OPENAI_CLASSIFY_BATCH_SIZE=60
# (선택) 제안 생성 타임아웃(ms), 기본 6000
# OPENAI_SUGGEST_TIMEOUT_MS=6000
# (선택) AI 고급분석 대상 최대 리뷰 수(부분 샘플링), 기본 180
# MAX_LLM_REVIEWS=180

# Optional: Supabase 저장 기능
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional: Paddle billing (월 구독 결제)
# 앱 기준 URL (예: https://reviewboost.co.kr)
APP_BASE_URL=
PADDLE_ENV=sandbox
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
PADDLE_BASIC_PRICE_ID=
PADDLE_PRO_PRICE_ID=

# Dev test overrides (로컬 개발 테스트 전용)
# 무료 플랜에서도 AI 고급 분석 토글을 강제로 노출/허용
# DEV_ALLOW_ADVANCED_AI=1
#
# 분석 모드 강제:
# - auto: UI 토글(useLLM)에 따름 (기본값)
# - heuristic: 항상 일반분석(휴리스틱)
# - llm: 항상 AI 고급분석(LLM) 시도
# DEV_FORCE_ANALYSIS_MODE=auto
