# ==========================================================
# ReviewBoost environment template
#
# Usage:
# - Local dev: copy to .env.local
# - Staging: set STAGING values in your deployment secrets manager
# - Production: set PROD values in your deployment secrets manager
#
# Rule:
# - REQUIRED: must be set before deploy
# - OPTIONAL: can be empty
# ==========================================================

# -----------------------------
# Shared (all environments)
# -----------------------------
# OPTIONAL
NODE_ENV=development

# REQUIRED
APP_ENV=local

# REQUIRED: public app URL used in links/callbacks
APP_BASE_URL=http://localhost:3001

# -----------------------------
# OpenAI
# -----------------------------
# OPTIONAL (feature fallback exists)
OPENAI_API_KEY=
# OPTIONAL
OPENAI_MODEL=gpt-4o-mini
# OPTIONAL
OPENAI_CLASSIFY_TIMEOUT_MS=12000
# OPTIONAL
OPENAI_CLASSIFY_BATCH_SIZE=60
# OPTIONAL
OPENAI_CLASSIFY_MAX_CONCURRENCY=2
# OPTIONAL
OPENAI_SUGGEST_TIMEOUT_MS=12000
# OPTIONAL
MAX_LLM_REVIEWS=180

# -----------------------------
# Auth (Clerk) — Vercel Marketplace integration이 자동 주입
# -----------------------------
# REQUIRED
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# REQUIRED
CLERK_SECRET_KEY=
# OPTIONAL: 컴포넌트 라우팅
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/signup
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# -----------------------------
# Database (Neon) — Vercel Marketplace integration이 자동 주입
# -----------------------------
# REQUIRED for persistence
DATABASE_URL=

# OPTIONAL: 문의 이메일
# CONTACT_EMAIL=kwan765@naver.com

# -----------------------------
# Payment (Paddle)
# -----------------------------
# OPTIONAL (required only when billing is enabled)
PADDLE_ENV=sandbox
# OPTIONAL
PADDLE_API_KEY=
# OPTIONAL
NEXT_PUBLIC_PADDLE_TOKEN_SANDBOX=
# OPTIONAL
NEXT_PUBLIC_PADDLE_TOKEN_LIVE=
# OPTIONAL (legacy fallback): used when env별 공개키가 없을 때만 사용
# 권장: 위 환경별 토큰 변수 사용
NEXT_PUBLIC_PADDLE_TOKEN=
# OPTIONAL
PADDLE_WEBHOOK_SECRET=
# OPTIONAL
PADDLE_BASIC_PRICE_ID=
# OPTIONAL
PADDLE_PRO_PRICE_ID=
# OPTIONAL: 크롬 익스텐션 전용 플랜(하루 2,000개 수집) 가격 ID
PADDLE_EXTENSION_PRICE_ID=

# -----------------------------
# Webhook / security
# -----------------------------
# OPTIONAL: comma-separated IP CIDRs for webhook allowlist
WEBHOOK_IP_ALLOWLIST=
# OPTIONAL: reject webhook requests older than this many seconds
WEBHOOK_MAX_AGE_SECONDS=300

# -----------------------------
# Storage / email (future integrations)
# -----------------------------
# OPTIONAL
STORAGE_PROVIDER=
# OPTIONAL
STORAGE_BUCKET=
# OPTIONAL
STORAGE_ACCESS_KEY=
# OPTIONAL
STORAGE_SECRET_KEY=
# OPTIONAL
SMTP_HOST=
# OPTIONAL
SMTP_PORT=587
# OPTIONAL
SMTP_USER=
# OPTIONAL
SMTP_PASS=
# OPTIONAL
SMTP_FROM=

# -----------------------------
# Observability
# -----------------------------
# OPTIONAL
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# OPTIONAL
GOOGLE_SITE_VERIFICATION=
# OPTIONAL
LOG_LEVEL=info
# OPTIONAL
SENTRY_DSN=

# -----------------------------
# Runtime / report generation
# -----------------------------
# OPTIONAL
# Optional. If unset, code scans assets/fonts/NotoSansKR-Regular.{ttf,otf} first.
REPORT_FONT_PATH=
# OPTIONAL (0/1): Puppeteer 실패 시 PDFKit fallback 사용 여부 (기본값 1)
REPORT_ENABLE_PDFKIT_FALLBACK=1
# OPTIONAL: Puppeteer 실행 파일 경로가 고정되어 있는 경우 지정
# 미설정 시 런타임은 /usr/bin/google-chrome, /usr/bin/chromium, /usr/bin/chromium-browser 순으로 자동 탐색합니다.
PUPPETEER_EXECUTABLE_PATH=
# OPTIONAL: Puppeteer launch/렌더 타임아웃(ms) (기본값 120000)
PUPPETEER_LAUNCH_TIMEOUT_MS=120000
# OPTIONAL: Puppeteer 재시도 횟수 (1회 실패 기준 총 시도 maxRetries+1회, 기본값 2)
PUPPETEER_MAX_RETRIES=2
# OPTIONAL (0/1): Puppeteer 실패 시 텍스트 폴백을 막고 501 처리 (기본값 0)
REPORT_REQUIRE_PUPPETEER_STYLE=0

# -----------------------------
# Development-only flags
# -----------------------------
# OPTIONAL - do not set in staging/prod
DEV_ALLOW_ADVANCED_AI=0
# OPTIONAL: auto | heuristic | llm
DEV_FORCE_ANALYSIS_MODE=auto


# ==========================================================
# STAGING example values (do not commit real secrets)
# ==========================================================
# APP_ENV=staging
# APP_BASE_URL=https://staging.reviewboost.example
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_staging
# CLERK_SECRET_KEY=sk_test_staging
# DATABASE_URL=postgres://user:pass@staging-neon-host/dbname?sslmode=require
# PADDLE_ENV=sandbox
# PADDLE_API_KEY=staging-paddle-api-key
# NEXT_PUBLIC_PADDLE_TOKEN_SANDBOX=staging-public-token
# NEXT_PUBLIC_PADDLE_TOKEN=staging-public-token
# PADDLE_WEBHOOK_SECRET=staging-webhook-secret
# PADDLE_BASIC_PRICE_ID=pri_staging_basic
# PADDLE_PRO_PRICE_ID=pri_staging_pro

# ==========================================================
# PROD example values (do not commit real secrets)
# ==========================================================
# APP_ENV=production
# APP_BASE_URL=https://reviewboost.example
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_prod
# CLERK_SECRET_KEY=sk_live_prod
# DATABASE_URL=postgres://user:pass@prod-neon-host/dbname?sslmode=require
# PADDLE_ENV=live
# PADDLE_API_KEY=prod-paddle-api-key
# NEXT_PUBLIC_PADDLE_TOKEN=live-public-token
# NEXT_PUBLIC_PADDLE_TOKEN_LIVE=live-public-token
# PADDLE_WEBHOOK_SECRET=prod-webhook-secret
# PADDLE_BASIC_PRICE_ID=pri_prod_basic
# PADDLE_PRO_PRICE_ID=pri_prod_pro
